# Copy this file to .env in this same "backend" folder

PORT=5000

# Must match the MONGO_URI you set in database/.env
MONGO_URI=mongodb://127.0.0.1:27017/cti_platform

# Optional — only needed if you want the NVD fetcher to use a higher rate limit
# Get one free at https://nvd.nist.gov/developers/request-an-api-key
# NVD_API_KEY=

# Optional — only needed if you want the AlienVault OTX fetcher enabled
# Get one free at https://otx.alienvault.com (Settings > API Integration)
# OTX_API_KEY=
